# ─────────────────────────────────────────────────────────────────
# Lovable Cloud (auto-managed — do not edit values in production)
# ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-anon-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# ─────────────────────────────────────────────────────────────────
# Backend (Edge Function) secrets — set via Lovable Cloud secrets UI
# These are NOT read from .env in production; placeholders for clarity.
# ─────────────────────────────────────────────────────────────────

# Lovable AI Gateway (auto-provisioned)
LOVABLE_API_KEY="<lovable-api-key>"

# Resend (transactional email). Leave empty to enable mock mode.
RESEND_API_KEY=""


# Stripe (secondary checkout)
STRIPE_SECRET_KEY=""

# FoundStart internal API token (admin webhooks)
found_start=""

# ─────────────────────────────────────────────────────────────────
# Feature flags (client-side, safe to expose)
# ─────────────────────────────────────────────────────────────────
VITE_ENABLE_MOCK_INTEGRATIONS="false"   # "true" forces mock for Resend/Stripe
VITE_ENABLE_PARTNER_ADS="true"